// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  AGENT

  @@map("role")
}

enum ConversationOrigin {
  GENERAL
  AGENCY

  @@map("conversation_origin")
}

enum ConversationStatus {
  OPEN
  CLOSED

  @@map("conversation_status")
}

enum SenderType {
  GUEST
  CUSTOMER
  AGENT

  @@map("sender_type")
}

enum AgencyType {
  CENTRAL
  BRANCH

  @@map("agency_type")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  role         Role      @default(CUSTOMER)
  customer     Customer? // 0 ou 1 profil client
  agencyId     String?   @map("agency_id") @db.Uuid

  refreshTokens RefreshToken[] // 0 à n jetons

  messages Message[]

  agency Agency? @relation(fields: [agencyId], references: [id])

  @@map("users")
}

model Customer {
  id               String         @id @db.Uuid
  user             User           @relation(fields: [id], references: [id], onDelete: Cascade)
  firstName        String         @map("first_name")
  lastName         String         @map("last_name")
  birthDate        DateTime       @map("birth_date") @db.Date
  address          String
  stripeCustomerId String?        @unique @map("stripe_customer_id")
  languageCode     String         @default("fr") @map("language_code")
  language         Language       @relation(fields: [languageCode], references: [code])
  conversations    Conversation[]

  @@map("customers")
}

model Language {
  code      String     @id
  name      String
  customers Customer[]

  @@map("languages")
}

model RefreshToken {
  id               String    @id @default(uuid()) @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @map("token_hash")
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  revokedAt        DateTime? @map("revoked_at")
  familyId         String    @map("family_id") @db.Uuid
  sessionExpiresAt DateTime  @map("session_expires_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Agency {
  id            String         @id @db.Uuid
  name          String
  conversations Conversation[]
  messages      Message[]
  agencyType    AgencyType     @default(BRANCH) @map("agency_type")
  users         User[]

  @@map("agencies")
}

model Conversation {
  id         String             @id @default(uuid()) @db.Uuid
  customerId String?            @map("customer_id") @db.Uuid
  customer   Customer?          @relation(fields: [customerId], references: [id])
  guestId    String?            @map("guest_id") @db.Uuid
  origin     ConversationOrigin @default(GENERAL)
  agencyId   String             @map("agency_id") @db.Uuid
  agency     Agency             @relation(fields: [agencyId], references: [id])
  bookingId  String?            @map("booking_id") @db.Uuid //pas de table booking dans PoC
  status     ConversationStatus @default(OPEN)
  openedAt   DateTime           @default(now()) @map("opened_at")
  closedAt   DateTime?          @map("closed_at")
  messages   Message[]

  @@map("conversations")
}

model Message {
  id String @id @default(uuid()) @db.Uuid

  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     SenderType   @map("sender_type")
  senderUserId   String?      @map("sender_user_id") @db.Uuid
  senderUser     User?        @relation(fields: [senderUserId], references: [id])
  senderAgencyId String?      @map("sender_agency_id") @db.Uuid
  senderAgency   Agency?      @relation(fields: [senderAgencyId], references: [id])
  content        String
  sentAt         DateTime     @default(now()) @map("sent_at")

  @@index([conversationId, sentAt])
  @@map("messages")
}
