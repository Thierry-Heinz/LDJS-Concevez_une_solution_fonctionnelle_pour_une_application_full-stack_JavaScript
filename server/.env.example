DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# Origine du front, autorisée par CORS (HTTP et WebSocket)
CLIENT_ORIGIN=http://localhost:5173

JWT_ACCESS_SECRET=SECRET_HERE
JWT_REFRESH_SECRET=SECRET_HERE
JWT_GUEST_SECRET=SECRET_HERE

# Durées en secondes
# Jeton d'accès : 15 min
ACCESS_TOKEN_TTL_SECONDS=900
# Jeton de rafraîchissement, expiration d'inactivité : 1 h
REFRESH_TOKEN_IDLE_TTL_SECONDS=3600
# Durée maximale d'une session, rafraîchissements compris : 3 h
SESSION_ABSOLUTE_TTL_SECONDS=10800
# Jeton invité : 3 jours
GUEST_TOKEN_TTL_SECONDS=259200
